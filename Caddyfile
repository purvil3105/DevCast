# Caddyfile for DevCast Self-Hosted Production
# DOMAIN environment variable is substituted from .env.prod
# Fallback to localhost so Caddy never crashes on an empty domain

{$DOMAIN:localhost} {

    # ── REST API ─────────────────────────────────────────────
    handle /api/* {
        reverse_proxy api:3000 {
            health_uri /api/health
            health_interval 15s
        }
    }

    # ── Uploaded Thumbnails / Assets ────────────────────────
    handle /uploads/* {
        reverse_proxy api:3000
    }

    # ── Socket.IO WebSocket ──────────────────────────────────
    handle /socket.io/* {
        reverse_proxy ws:3001 {
            header_up Host {upstream_hostport}
            header_up X-Real-IP {remote_host}
        }
    }

    # ── Live HLS Streaming ───────────────────────────────────
    handle /hls/* {
        root * /var/hls/live
        uri strip_prefix /hls
        file_server
        header Access-Control-Allow-Origin *
        header Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    }

    # ── Recorded VOD Playback ────────────────────────────────
    handle /vod/* {
        root * /var/hls/vod
        uri strip_prefix /vod
        file_server
        header Access-Control-Allow-Origin *
        header Cache-Control "public, max-age=86400"
    }

    # ── React SPA (catch-all) ────────────────────────────────
    handle {
        reverse_proxy client:80
    }

    # ── Access Log ───────────────────────────────────────────
    log {
        output file /var/log/caddy/access.log {
            roll_size 20MB
            roll_keep 5
        }
    }
}
