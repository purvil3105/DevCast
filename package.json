{
  "name": "devcast",
  "version": "1.0.0",
  "private": true,
  "description": "DevCast — Interactive Live Learning Platform",
  "workspaces": [
    "server",
    "client",
    "sandbox"
  ],
  "scripts": {
    "dev": "concurrently -n server,sandbox,client -c blue,yellow,green \"npm run dev -w server\" \"npm run dev -w sandbox\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:sandbox": "npm run dev -w sandbox",
    "dev:client": "npm run dev -w client",
    "db:push": "npm run db:push -w server",
    "db:seed": "npm run db:seed -w server",
    "db:studio": "npm run db:studio -w server",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^7.0.2"
  }
}
