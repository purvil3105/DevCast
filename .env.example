# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit .env or put server secrets in client/.env files.
#
# ─── Database ─────────────────────────────────────────────
# Option A: Neon (recommended — free managed Postgres)
#   Sign up at https://neon.tech -> create project -> copy connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Option B: Docker (run `docker compose up -d` first)
# DATABASE_URL="postgresql://devcast:devcast_dev@localhost:5432/devcast"

# ─── Redis ────────────────────────────────────────────────
# Option A: Upstash (recommended — free managed Redis)
#   Sign up at https://upstash.com -> create Redis database -> copy URL
REDIS_URL="rediss://default:PASSWORD@HOST.upstash.io:6379"

# Option B: Docker (run `docker compose up -d` first)
# REDIS_URL="redis://localhost:6379"

# ─── Auth ─────────────────────────────────────────────────
# REQUIRED. Generate a strong secret with:  openssl rand -hex 32
# The server refuses to boot in production with a weak/default secret.
JWT_SECRET="generate-with-openssl-rand-hex-32"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Shared secret for media-server -> API internal calls (VOD-ready webhook).
# REQUIRED in production. Generate with:  openssl rand -hex 32
# Must match the value passed to media-server/s3_upload.sh.
INTERNAL_API_SECRET="generate-with-openssl-rand-hex-32"

# ─── AI (Google Gemini) ──────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"

# ─── Cloudinary (stream thumbnail uploads) ───────────────
# Create a free account at https://cloudinary.com -> Dashboard shows these three.
# Optional: if unset, the thumbnail upload endpoint returns 503 and streams
# simply have no thumbnail. The API secret stays server-side only.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Sandbox Service ─────────────────────────────────────
SANDBOX_URL="http://localhost:4000"
SANDBOX_TIMEOUT_MS=10000
SANDBOX_PORT=4000

# ─── Server ───────────────────────────────────────────────
# API server (REST/Auth) and WS server (Socket.IO) run on SEPARATE ports.
PORT=3000
WS_PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"
# Public WS origin the browser connects to (used for the CSP connect-src).
# In production set this to your deployed WS origin, e.g. wss://ws.example.com
WS_PUBLIC_URL="ws://localhost:3001"

# ─── Client (Vite) ───────────────────────────────────────
# The client reads client/.env — mirror these there for the frontend build.
VITE_API_URL="http://localhost:3000"
VITE_WS_URL="ws://localhost:3001"
