# .env.prod.example — DevCast Production Secrets Template
# Copy this file to .env.prod on your VM: cp .env.prod.example .env.prod
# Generate random secrets with: openssl rand -hex 32

# ── Domain ──────────────────────────────────────────────────────────
# Must point to your Oracle/Azure VM public IP via DNS A record
DOMAIN=devcast.yourdomain.com

# ── PostgreSQL Database ─────────────────────────────────────────────
POSTGRES_USER=devcast
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_generated_postgres_password

# ── Redis ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=replace_with_generated_redis_password

# ── Authentication & Security ───────────────────────────────────────
# MUST be at least 32 characters (enforced by server in production)
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_random_64_char_hex_jwt_secret
INTERNAL_API_SECRET=replace_with_random_64_char_hex_internal_secret

# ── AI Hints (Google Gemini) ────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Cloudinary (Optional) ───────────────────────────────────────────
# Leave blank to disable cloud thumbnail uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
